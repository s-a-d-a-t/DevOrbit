PORT=5000
# Neon / Postgres connection string.
# Replace USERNAME, PASSWORD, HOST, and DB with your own values.
DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST/DB?sslmode=require&channel_binding=require

# Generate a long random secret before sharing or deploying.
JWT_SECRET=replace-with-a-long-random-secret

JWT_EXPIRES=7d

# Set MEMORY_DB=1 to run against an embedded dev PostgreSQL
# (auto-downloaded, data wiped each run).
MEMORY_DB=0
